<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.pkyit</groupId>
        <artifactId>notifyx-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>notifyx-store-redis</artifactId>
    <name>NotifyX Store Redis</name>
    <description>Redis 分布式去重与限流（T1 能力梯度，可选）</description>

    <properties>
        <!-- 脚本与降级逻辑都有单测；Redis 协议交互由 live 测试覆盖 -->
        <jacoco.minimum>0.60</jacoco.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.pkyit</groupId>
            <artifactId>notifyx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- 用户显式引入；不传递给只引 starter 的业务方（T0 仍可零依赖启动） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.pkyit</groupId>
            <artifactId>notifyx-spring-boot3-autoconfigure</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
