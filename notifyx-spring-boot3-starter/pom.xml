<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.pkyit</groupId>
        <artifactId>notifyx-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>notifyx-spring-boot3-starter</artifactId>
    <name>NotifyX Spring Boot 3 Starter (alias)</name>
    <description>归档坐标：仅用于迁移提示，实际实现由 notifyx-spring-boot-starter 提供（ADR-001）</description>

    <!--
      ADR-001 方案 C：主推 notifyx-spring-boot-starter，本坐标作为 alias 长期保留。
      relocation 让 Maven / IDE 在用户引用旧坐标时给出迁移提示并解析到主坐标。
    -->
    <distributionManagement>
        <relocation>
            <groupId>io.github.pkyit</groupId>
            <artifactId>notifyx-spring-boot-starter</artifactId>
            <version>${project.version}</version>
            <message>notifyx-spring-boot3-starter 已迁移到 notifyx-spring-boot-starter，请更新依赖坐标（ADR-001）</message>
        </relocation>
    </distributionManagement>

    <dependencies>
        <!-- 依赖壳：即使 relocation 未生效，也能拿到完整实现 -->
        <dependency>
            <groupId>io.github.pkyit</groupId>
            <artifactId>notifyx-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
